<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-feature android:name="android.hardware.camera" android:required="false"/>
 <application android:name=".SafeApplication" android:allowBackup="false" android:fullBackupContent="false" android:usesCleartextTraffic="false" android:label="Safe to Send" android:theme="@style/AppTheme">
 <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
 <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.camera" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/camera_paths"/></provider>
 </application>
</manifest>